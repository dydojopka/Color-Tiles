<?xml version="1.0" encoding="utf-8"?>
<!-- Прокрутка позволяет увидеть все поле, если экран низкий -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/game_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Поле занимает всю ширину, такую же высоту задает код экрана -->
        <LinearLayout
            android:id="@+id/field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/grid_line"
            android:orientation="vertical">

            <!-- Одинаковый вес дает четырем строкам равную высоту -->
            <LinearLayout
                android:id="@+id/row0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- Вес делит ширину поровну, отступы открывают фон поля как линии сетки -->
                <!-- Тег хранит строку и столбец, onClick указывает обработчик нажатия -->
                <View
                    android:id="@+id/t00"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="00" />

                <View
                    android:id="@+id/t01"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="01" />

                <View
                    android:id="@+id/t02"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="02" />

                <View
                    android:id="@+id/t03"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="03" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <View
                    android:id="@+id/t10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="10" />

                <View
                    android:id="@+id/t11"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="11" />

                <View
                    android:id="@+id/t12"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="12" />

                <View
                    android:id="@+id/t13"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="13" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <View
                    android:id="@+id/t20"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="20" />

                <View
                    android:id="@+id/t21"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="21" />

                <View
                    android:id="@+id/t22"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="22" />

                <View
                    android:id="@+id/t23"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="23" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <View
                    android:id="@+id/t30"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="30" />

                <View
                    android:id="@+id/t31"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="31" />

                <View
                    android:id="@+id/t32"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="32" />

                <View
                    android:id="@+id/t33"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/bright"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:tag="33" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="16dp"
            android:onClick="reset"
            android:text="@string/new_game" />

        <TextView
            android:id="@+id/generation_moves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
